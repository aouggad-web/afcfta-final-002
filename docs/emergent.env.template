# --- Détection du pays (routage Stripe / Chargily) — Cloudflare ----------- #
# Le domaine de l'API est derrière Cloudflare : les en-têtes CF-* ne sont crus
# que si la provenance est prouvée. Injectez X-Edge-Secret via une Transform
# Rule Cloudflare et reportez la même valeur ici (voir docs/CLOUDFLARE_SETUP.md).
CLOUDFLARE_EDGE_SECRET=
# À défaut, si l'origine est fermée au réseau (Tunnel/pare-feu) : true.
TRUST_CLOUDFLARE_HEADERS=false
# Quelles IP sources sont autorisées à poser les en-têtes de proxy (uvicorn
# --forwarded-allow-ips). Défaut prudent : personne d'autre que la boucle locale.
# Ne passez à `*` que si l'origine est STRICTEMENT fermée (Tunnel ou pare-feu sur
# les plages Cloudflare) : sinon n'importe qui peut forger X-Forwarded-For.
# Note : la détection de pays lit X-Forwarded-For directement et ne dépend pas de
# ce réglage — le changer ne « répare » donc pas une géolocalisation absente.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# Alternative sans Cloudflare (recommandée sur Emergent tant que le passage des
# en-têtes CF-* par l'ingress n'est pas confirmé) : base MaxMind GeoLite2 locale.
#   python scripts/geoip_update.py --dest /app/data/geoip
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
MAXMIND_LICENSE_KEY=
# Vérification empirique de l'ingress : GET /api/billing/geo-diagnostic depuis
# l'extérieur montre l'IP client vue, le pays détecté et les en-têtes reçus.

# --- Relais en frontal (IP réelle du visiteur) ----------------------------- #
# Nombre de proxies devant l'application. Détermine quelle entrée de
# X-Forwarded-For porte l'IP du visiteur. Réglage EMPIRIQUE : appelez
# /api/billing/geo-diagnostic et comparez `client_ip` à votre IP publique réelle
# (api.ipify.org), en incrémentant jusqu'à ce qu'elles coïncident.
# Une valeur trop basse renvoie une IP d'infrastructure, identique pour tous :
# géolocalisation fausse ET quota de débit partagé par l'ensemble des visiteurs.
# Mesuré le 13/08/2026 sur ai-opportunities-6.preview.emergentagent.com : 3.
TRUSTED_PROXY_HOPS=3

# --- Limitation de débit --------------------------------------------------- #
# Quota par IP et par section d'API. Webhooks de paiement et /api/health
# exemptés ; connexion/inscription plafonnées séparément (force brute).
# Si un quota s'avère trop serré en production, ajustez ici — ou coupez
# temporairement avec RATE_LIMIT_ENABLED=false — sans redéployer le code.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Notifications opérationnelles crawler (distinctes du SaaS) ------------ #
# Alertes techniques du crawler vers une liste d'admins (facultatif).
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=smtp.zoho.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@afcfta-zlecaf.com
EMAIL_TO=
EMAIL_USE_TLS=true
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=

# --- IA (facultatif : active les endpoints IA à coût réel) ---------------- #
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Sources de données externes (facultatif : la plupart marchent sans clé) #
# OEC (statistiques) fonctionne SANS token via le canal gratuit. Le token
# n'active que la demande premium.
OEC_API_TOKEN=
COMTRADE_API_KEY=
UNCTAD_TRAINS_API_KEY=
FIXER_API_KEY=
CURRENCYFREAKS_API_KEY=
WTO_API_KEY=
