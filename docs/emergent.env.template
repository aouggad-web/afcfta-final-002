# =============================================================================
# .env de PRODUCTION — pod Emergent (/app/backend/.env)
# =============================================================================
# Ce fichier est la SOURCE UNIQUE des secrets runtime en production Emergent.
# Il vit sur le pod (protégé par `git clean -e .env` dans sync_emergent.sh) et
# n'est JAMAIS committé. Copiez-le vers /app/backend/.env sur Emergent, puis
# remplissez les valeurs réelles.
#
#   Cutover depuis Replit :
#     1. Récupérez les valeurs actuelles depuis les Secrets Replit.
#     2. Reportez-les ici, sur le pod Emergent (/app/backend/.env).
#     3. Aucune variable REPLIT_* n'est nécessaire : le backend les ignore
#        quand elles sont absentes (blocs CORS optionnels dans server.py).
#     4. Redéployez : `BRANCH=main bash sync_emergent.sh` puis supervisord.
# =============================================================================

# --- Application ---------------------------------------------------------- #
APP_ENV=production
LOG_LEVEL=info
# Ports imposés par l'ingress Kubernetes d'Emergent (cf. docs/DEPLOYER_SUR_EMERGENT.md)
BACKEND_PORT=8001
FRONTEND_PORT=3000
# Secret de session/app — générez-en un neuf (min. 32 caractères) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGEZ-MOI-32-caracteres-minimum

# --- CORS / domaines ------------------------------------------------------ #
# Domaine(s) autorisés à appeler l'API (séparés par des virgules).
# Mettez ici le domaine public Emergent + le domaine officiel du SaaS.
ALLOWED_ORIGINS=https://afcfta-zlecaf.com,https://VOTRE-SOUS-DOMAINE.emergent.host
HTTPS_ENABLED=true
# URL publique du frontend (liens absolus dans certaines réponses).
FRONTEND_URL=https://afcfta-zlecaf.com

# --- Accès aux données ---------------------------------------------------- #
# true = données tarifaires/commerciales accessibles sans clé (info publique).
# false = clé API requise sur chaque requête.
PUBLIC_DATA_ACCESS=true

# --- Bases de données (optionnelles : dégradation automatique si absentes) - #
# MongoDB : requise pour l'auth par clé API et les quotas. Sans elle, le
# backend passe en mode public (aucune validation de clé).
MONGO_URL=
DB_NAME=afcfta
# PostgreSQL : cache tarifaire canonique (facultatif).
POSTGRES_URL=
DATABASE_URL=
# Redis : cache. Sinon cache mémoire (dégradation automatique).
REDIS_URL=

# --- E-mail transactionnel SaaS (Zoho) ------------------------------------ #
# Vérification d'inscription, bienvenue. Voir backend/notifications/transactional_email.py
SAAS_EMAIL_ENABLED=true
SAAS_SMTP_HOST=smtp.zoho.com
SAAS_SMTP_PORT=587
SAAS_SMTP_USER=noreply@afcfta-zlecaf.com
SAAS_SMTP_PASSWORD=CHANGEZ-MOI-mot-de-passe-application-zoho
SAAS_SMTP_USE_TLS=true
SAAS_EMAIL_FROM=AfCFTA ZLECAf <noreply@afcfta-zlecaf.com>
SAAS_EMAIL_REPLY_TO=contact@afcfta-zlecaf.com
SAAS_APP_BASE_URL=https://afcfta-zlecaf.com

# --- Notifications opérationnelles crawler (distinctes du SaaS) ------------ #
# Alertes techniques du crawler vers une liste d'admins (facultatif).
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=smtp.zoho.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@afcfta-zlecaf.com
EMAIL_TO=
EMAIL_USE_TLS=true
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=

# --- IA (facultatif : active les endpoints IA à coût réel) ---------------- #
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Sources de données externes (facultatif : la plupart marchent sans clé) #
# OEC (statistiques) fonctionne SANS token via le canal gratuit. Le token
# n'active que la demande premium.
OEC_API_TOKEN=
COMTRADE_API_KEY=
UNCTAD_TRAINS_API_KEY=
FIXER_API_KEY=
CURRENCYFREAKS_API_KEY=
WTO_API_KEY=
