name: Run AfCFTA Data Pipeline

on:
  workflow_dispatch: {}
  push:
    branches: [ main ]
    paths:
      - "**/*.py"
      - ".github/workflows/run_data_pipeline.yml"

jobs:
  build-data:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Python dependencies (optional)
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Run validation script
        run: |
          python create_validation_file.py

      - name: Generate enhanced Excel 2024
        run: |
          python create_enhanced_excel_2024.py

      - name: Generate complete Excel final
        run: |
          python create_complete_excel_final.py

      - name: Collect outputs
        run: |
          mkdir -p artifacts
          # Adaptez ces patterns à vos noms réels de sortie
          find . -maxdepth 3 -type f \( -iname "*.xlsx" -o -iname "*.csv" -o -iname "*.json" \) -print
          find . -maxdepth 3 -type f \( -iname "*.xlsx" -o -iname "*.csv" -o -iname "*.json" \) -exec cp --parents {} artifacts/ \; || true

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: afcfta-data-outputs
          path: artifacts
