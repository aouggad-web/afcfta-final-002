# ============================================================
# ZLECAf Trade Calculator — Configuration
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs

# === Base de données ===
MONGO_URL=mongodb://localhost:27017
DB_NAME=zlecaf_db
POSTGRES_URL=postgresql://user:password@localhost:5432/afcfta_regulatory

# === Redis (Cache) ===
REDIS_URL=redis://localhost:6379

# === Backend ===
SECRET_KEY=your-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# === Notifications Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =========================================
# Slack Notifications Configuration
# =========================================
# Enable/disable Slack notifications
SLACK_NOTIFICATIONS_ENABLED=true

# Slack webhook URL
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel name (optional, webhook has default)
SLACK_CHANNEL=#afcfta-monitoring

# =========================================
# Application Configuration
# =========================================
# Application environment
APP_ENV=production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# =========================================
# Security Configuration
# =========================================
# Comma-separated list of allowed CORS origins
# If not set, defaults to localhost + afcfta.trade domains
ALLOWED_ORIGINS=https://afcfta.trade,https://www.afcfta.trade,http://localhost:3000,http://localhost:5000

# Frontend URL (added to CORS allowlist automatically)
FRONTEND_URL=

# Set to true when serving over HTTPS (enables secure flag on CSRF cookie)
HTTPS_ENABLED=false

# =========================================
# Optional: External Services
# =========================================
# Gemini API (for AI-powered analysis)
GEMINI_API_KEY=your-gemini-api-key

# Other service API keys as needed
# WORLD_BANK_API_KEY=
# OEC_API_KEY=
# WORLD_BANK_API_KEY=
