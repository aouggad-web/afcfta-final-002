# ============================================================
# ZLECAf Trade Calculator — Configuration
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs

# === Base de données ===
MONGO_URL=mongodb://localhost:27017
DB_NAME=zlecaf_db
POSTGRES_URL=postgresql://user:password@localhost:5432/afcfta_regulatory

# === Redis (Cache) ===
# PRODUCTION REQUIRED: Always set a password for Redis in production.
# Format: redis://:YOUR_PASSWORD@host:port
REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_PASSWORD=your-redis-password

# === Backend ===
SECRET_KEY=your-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# === Transactional email (SaaS user-facing: signup verification, welcome) ===
# Distinct from the crawler-alert SMTP above. Uses the official SaaS identity.
# Provider: Zoho Mail. Pick the SMTP host matching your account's data center:
#   International -> smtp.zoho.com | EU -> smtp.zoho.eu | India -> smtp.zoho.in
# SAAS_SMTP_USER must be the full mailbox (same as the From address), and
# SAAS_SMTP_PASSWORD must be a Zoho *app-specific password* (Zoho > Security >
# App Passwords) when two-factor auth is enabled on the mailbox.
SAAS_EMAIL_ENABLED=false
SAAS_SMTP_HOST=smtp.zoho.com
SAAS_SMTP_PORT=587
SAAS_SMTP_USER=noreply@afcfta-zlecaf.com
SAAS_SMTP_PASSWORD=your-zoho-app-password
SAAS_SMTP_USE_TLS=true
SAAS_EMAIL_FROM=AfCFTA ZLECAf <noreply@afcfta-zlecaf.com>
SAAS_EMAIL_REPLY_TO=contact@afcfta-zlecaf.com
SAAS_APP_BASE_URL=https://afcfta-zlecaf.com

# === Notifications Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =========================================
# Slack Notifications Configuration
# =========================================
# Enable/disable Slack notifications
SLACK_NOTIFICATIONS_ENABLED=true

# Slack webhook URL
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel name (optional, webhook has default)
SLACK_CHANNEL=#afcfta-monitoring

# =========================================
# Application Configuration
# =========================================
# Application environment — set to 'production' on live deployments.
# When APP_ENV=production, the OpenAPI docs (/docs, /redoc) are disabled.
APP_ENV=production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# =========================================
# Security Configuration
# =========================================
# Comma-separated list of allowed CORS origins
# If not set, defaults to localhost + afcfta.trade domains
ALLOWED_ORIGINS=https://afcfta.trade,https://www.afcfta.trade,http://localhost:3000,http://localhost:5000

# Tariff/trade data is public information: data endpoints stay accessible
# without an API key even once MongoDB (and key validation) is configured.
# Set to 'false' to require a key on every request, including plain data reads.
# AI endpoints (/api/ai/*) always require a key regardless of this setting.
PUBLIC_DATA_ACCESS=true

# Frontend URL (added to CORS allowlist automatically)
FRONTEND_URL=

# Replit app domain for CORS (only set when deploying on Replit).
# Example: my-app.username.replit.app
# Leave blank for non-Replit deployments.
REPLIT_APP_DOMAIN=

# PRODUCTION REQUIRED: Set to 'true' when serving over HTTPS.
# Enables the Strict-Transport-Security (HSTS) response header.
# NEVER leave as 'false' in production — CSRF cookies will not be secure.
HTTPS_ENABLED=false

# IP or CIDR of the upstream reverse-proxy that Uvicorn should trust
# for the X-Forwarded-For header.  Use 127.0.0.1 when the proxy runs
# on the same host, or the proxy's actual IP/subnet in other setups.
# Set to * only in development.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# =========================================
# Optional: External Services
# =========================================
# Anthropic Claude API (for AI-powered trade analysis — replaces Gemini)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Legacy Gemini API key (deprecated — kept for backwards compatibility only)
# GEMINI_API_KEY=your-gemini-api-key

# Other service API keys as needed
# WORLD_BANK_API_KEY=
# OEC paid-plan token — enables the latest, fine-grained BACI trade flows used by
# the premium Opportunités report engine (market-seeking demand + per-product
# market potential). Set as a deployment secret; NEVER commit a real token.
# Either variable name works (OEC_API_TOKEN takes precedence).
# OEC_API_TOKEN=
# OEC_API_KEY=
# Optional: override the OEC base URL if the paid plan uses a distinct host.
# OEC_BASE_URL=https://api-v2.oec.world/tesseract/data.jsonrecords

# =========================================
# Résilience des séries commerciales (trade-series)
# =========================================
# Sources de secours quand OEC est indisponible/rate-limité. OEC reste la
# source primaire. Activer une source par sa variable ci-dessous (désactivées
# par défaut). Valider d'abord en réseau via:
#   GET /api/oec/trade-series/sources/NGA
#
# GRATUIT, sans clé — à activer en premier:
WTO_FALLBACK_ENABLED=false        # OMC/WTO (API timeseries gratuite, sans clé)
#
# GRATUIT, mais nécessite l'URL de l'API UNCTADstat:
UNCTAD_FALLBACK_ENABLED=false
# UNCTAD_API_URL=
#
# Nécessite une clé d'API UN Comtrade (tier gratuit avec quota):
COMTRADE_FALLBACK_ENABLED=false
# COMTRADE_API_KEY=
