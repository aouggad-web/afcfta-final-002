# ============================================================
# ZLECAf Trade Calculator — Configuration
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs

# === Base de données ===
MONGO_URL=mongodb://localhost:27017
DB_NAME=zlecaf_db
POSTGRES_URL=postgresql://user:password@localhost:5432/afcfta_regulatory

# === Redis (Cache) ===
# PRODUCTION REQUIRED: Always set a password for Redis in production.
# Format: redis://:YOUR_PASSWORD@host:port
REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_PASSWORD=your-redis-password

# === Backend ===
SECRET_KEY=your-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# === Transactional email (SaaS user-facing: welcome on signup, contact-form
# admin notification) — backend/services/email_service.py. Distinct from the
# crawler-alert SMTP above. Provider: Zoho Mail. Pick the SMTP host matching
# your account's data center:
#   International -> smtp.zoho.com | EU -> smtp.zoho.eu | India -> smtp.zoho.in
# SAAS_SMTP_USER must be the full mailbox (used as the From address, and as
# the admin recipient for contact-form notifications), and SAAS_SMTP_PASSWORD
# must be a Zoho *app-specific password* (Zoho > Security > App Passwords)
# when two-factor auth is enabled on the mailbox.
SAAS_EMAIL_ENABLED=false
SAAS_SMTP_HOST=smtp.zoho.com
SAAS_SMTP_PORT=587
SAAS_SMTP_USER=noreply@afcfta-zlecaf.com
SAAS_SMTP_PASSWORD=your-zoho-app-password
SAAS_SMTP_USE_TLS=true

# === SaaS user accounts (JWT session auth) — backend/routes/user_auth.py ===
# JWT_SECRET signs the httpOnly session cookie — generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret-min-32-chars
# Admin account auto-seeded (or password re-synced) on backend startup.
ADMIN_EMAIL=admin@afcfta-zlecaf.com
ADMIN_PASSWORD=change-me-strong-password

# === Paiement — Stripe (international) — backend/routes/billing.py ===
# Mode TEST tant que le compte est en vérification : utilisez sk_test_ / pk_test_.
# Générez les price_id avec: python scripts/stripe_setup.py
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Secret du endpoint webhook (Dashboard > Développeurs > Webhooks, ou `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Identifiants de prix récurrents (mensuel _M / annuel _Y) — non secrets.
# Valeurs du compte ZLECAf (mode TEST), créées par scripts/stripe_setup.py.
# En passage au mode LIVE, relancez le script avec la clé sk_live_ : il créera
# les prix équivalents côté live et affichera les nouveaux price_id à substituer.
STRIPE_PRICE_STARTER_M=price_1U301SRtV7FwEMAMlbI5hOeG
STRIPE_PRICE_STARTER_Y=price_1U301TRtV7FwEMAMFFhHziOZ
STRIPE_PRICE_PRO_M=price_1U301TRtV7FwEMAMofey6gHr
STRIPE_PRICE_PRO_Y=price_1U301URtV7FwEMAMIWt2kmC6
STRIPE_PRICE_BUSINESS_M=price_1U301URtV7FwEMAMWnG17Btw
STRIPE_PRICE_BUSINESS_Y=price_1U301VRtV7FwEMAMddeumEzP
# URLs de retour après Checkout.
BILLING_SUCCESS_URL=https://afcfta-zlecaf.com/merci
BILLING_CANCEL_URL=https://afcfta-zlecaf.com/tarifs

# === Paiement — Chargily Pay (Algérie, CIB/Edahabia) — backend/routes/billing.py ===
# Passe à true pour activer la branche algérienne du checkout (sinon 501).
CHARGILY_ENABLED=false
# Dashboard Chargily > Développeurs > API : test_sk_... puis live_sk_...
CHARGILY_SECRET_KEY=
# Secret de signature des webhooks (à défaut, CHARGILY_SECRET_KEY est utilisée).
CHARGILY_WEBHOOK_SECRET=
# Endpoint API (test: https://pay.chargily.net/test/api/v2)
CHARGILY_API_BASE=https://pay.chargily.net/api/v2
# Montants en DINARS ALGÉRIENS (entiers, min. 75 DZD) — grille locale dédiée,
# indépendante des prix USD. Ancrage retenu : Pro mensuel = 2 500 DZD, les
# autres montants en découlent proportionnellement (~131,6 DZD par dollar).
# Les valeurs _Y sont le TOTAL ANNUEL (Chargily encaisse en une fois).
CHARGILY_PRICE_STARTER_M=1200
CHARGILY_PRICE_STARTER_Y=11000
CHARGILY_PRICE_PRO_M=2500
CHARGILY_PRICE_PRO_Y=23700
CHARGILY_PRICE_BUSINESS_M=7800
CHARGILY_PRICE_BUSINESS_Y=77500

# === Cloudflare en frontal (preuve de provenance des en-têtes CF-*) ===
# Les en-têtes CF-IPCountry / CF-Connecting-IP ne sont crus QUE si la requête
# vient prouvablement de Cloudflare — sinon n'importe qui pourrait les forger
# en appelant l'origine directement et contourner le verrou Algérie.
# Option 1 (recommandée) : secret partagé injecté par une Transform Rule
# Cloudflare dans l'en-tête X-Edge-Secret. Générez-le avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDFLARE_EDGE_SECRET=
# Option 2 : faire confiance sans vérifier — uniquement si l'origine est
# réellement injoignable hors Cloudflare (pare-feu sur les plages CF, ou Tunnel).
TRUST_CLOUDFLARE_HEADERS=false
# Voir aussi UVICORN_FORWARDED_ALLOW_IPS plus bas : ne l'élargissez à `*` que si
# l'origine est strictement fermée, sinon X-Forwarded-For devient falsifiable.

# === Détection du pays de facturation (routage Stripe / Chargily) ===
# Une IP algérienne impose Chargily. Deux sources possibles, optionnelles :
#  1. Cloudflare en frontal : l'en-tête CF-IPCountry est utilisé automatiquement.
#  2. Base MaxMind GeoLite2 locale : renseignez le chemin du .mmdb ci-dessous
#     (le paquet geoip2 est fourni par requirements.txt). Compte gratuit sur
#     maxmind.com.
# Sans source configurée, le pays reste indéterminé et l'on retombe sur le choix
# explicite de l'utilisateur — aucun paiement n'est bloqué sur une donnée absente.
# Base locale : téléchargez-la avec scripts/geoip_update.py (compte MaxMind
# gratuit requis), puis pointez GEOIP_DB_PATH vers le .mmdb produit.
GEOIP_DB_PATH=
MAXMIND_LICENSE_KEY=
# Diagnostic : GET /api/billing/geo-diagnostic montre ce que le backend voit
# (IP client, pays détecté, en-têtes présents) — utile pour vérifier ce que
# l'ingress de l'hébergeur laisse réellement passer.
# Dérogation individuelle : poser billing_stripe_exemption=true sur un document
# utilisateur (via la base) autorise Stripe malgré une IP algérienne — pour les
# voyageurs, expatriés et VPN d'entreprise légitimes.

# === Notifications Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# =========================================
# Slack Notifications Configuration
# =========================================
# Enable/disable Slack notifications
SLACK_NOTIFICATIONS_ENABLED=true

# Slack webhook URL
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel name (optional, webhook has default)
SLACK_CHANNEL=#afcfta-monitoring

# =========================================
# Application Configuration
# =========================================
# Application environment — set to 'production' on live deployments.
# When APP_ENV=production, the OpenAPI docs (/docs, /redoc) are disabled.
APP_ENV=production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# =========================================
# Security Configuration
# =========================================
# Comma-separated list of allowed CORS origins
# If not set, defaults to localhost + afcfta.trade domains
ALLOWED_ORIGINS=https://afcfta.trade,https://www.afcfta.trade,http://localhost:3000,http://localhost:5000

# --- Relais en frontal (IP réelle du visiteur) ---
# Nombre de proxies devant l'application. Détermine quelle entrée de
# X-Forwarded-For porte l'IP du visiteur. Réglage EMPIRIQUE : appelez
# /api/billing/geo-diagnostic et comparez `client_ip` à votre IP publique réelle
# (api.ipify.org), en incrémentant jusqu'à ce qu'elles coïncident.
# Une valeur trop basse renvoie une IP d'infrastructure, identique pour tous :
# géolocalisation fausse ET quota de débit partagé par l'ensemble des visiteurs.
TRUSTED_PROXY_HOPS=1

# --- Limitation de débit (backend/middlewares/rate_limiter.py) ---
# Quota par IP et par section d'API (/api/<section>/...). Les webhooks de
# paiement et /api/health sont exemptés ; la connexion et l'inscription ont un
# quota dédié, bien plus serré, contre la force brute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# Tariff/trade data is public information: data endpoints stay accessible
# without an API key even once MongoDB (and key validation) is configured.
# Set to 'false' to require a key on every request, including plain data reads.
# AI endpoints (/api/ai/*) always require a key regardless of this setting.
PUBLIC_DATA_ACCESS=true

# Frontend URL (added to CORS allowlist automatically)
FRONTEND_URL=

# Replit app domain for CORS (only set when deploying on Replit).
# Example: my-app.username.replit.app
# Leave blank for non-Replit deployments.
REPLIT_APP_DOMAIN=

# PRODUCTION REQUIRED: Set to 'true' when serving over HTTPS.
# Enables the Strict-Transport-Security (HSTS) response header.
# NEVER leave as 'false' in production — CSRF cookies will not be secure.
HTTPS_ENABLED=false

# IP or CIDR of the upstream reverse-proxy that Uvicorn should trust
# for the X-Forwarded-For header.  Use 127.0.0.1 when the proxy runs
# on the same host, or the proxy's actual IP/subnet in other setups.
# Set to * only in development.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# =========================================
# Optional: External Services
# =========================================
# Anthropic Claude API (for AI-powered trade analysis — replaces Gemini)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Legacy Gemini API key (deprecated — kept for backwards compatibility only)
# GEMINI_API_KEY=your-gemini-api-key

# Other service API keys as needed
# WORLD_BANK_API_KEY=
# OEC paid-plan token — enables the latest, fine-grained BACI trade flows used by
# the premium Opportunités report engine (market-seeking demand + per-product
# market potential). Set as a deployment secret; NEVER commit a real token.
# Either variable name works (OEC_API_TOKEN takes precedence).
# OEC_API_TOKEN=
# OEC_API_KEY=
# Optional: override the OEC base URL if the paid plan uses a distinct host.
# OEC_BASE_URL=https://api-v2.oec.world/tesseract/data.jsonrecords

# =========================================
# Résilience des séries commerciales (trade-series)
# =========================================
# Sources de secours quand OEC est indisponible/rate-limité. OEC reste la
# source primaire. Activer une source par sa variable ci-dessous (désactivées
# par défaut). Valider d'abord en réseau via:
#   GET /api/oec/trade-series/sources/NGA
#
# GRATUIT, sans clé — à activer en premier:
WTO_FALLBACK_ENABLED=false        # OMC/WTO (API timeseries gratuite, sans clé)
#
# GRATUIT, mais nécessite l'URL de l'API UNCTADstat:
UNCTAD_FALLBACK_ENABLED=false
# UNCTAD_API_URL=
#
# Nécessite une clé d'API UN Comtrade (tier gratuit avec quota):
COMTRADE_FALLBACK_ENABLED=false
# COMTRADE_API_KEY=
