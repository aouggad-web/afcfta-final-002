# Frontend (Vite) — copier vers frontend/.env
# URL du backend pour le développement local (VS Code).
VITE_BACKEND_URL=http://localhost:8000

# Supabase Auth (facultatif) : URL du projet + clé PUBLIQUE uniquement.
# Laisser vide pour garder l'ancien système de comptes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
